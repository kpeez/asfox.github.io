---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BrainHero from '../components/BrainHero.astro';
import PersonPhoto from '../components/PersonPhoto.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ThemeIcon from '../components/ThemeIcon.astro';
import { fmtMonth, getNews, getPeople, getPublications, getThemes, isoDate } from '../lib/data';
import { SITE } from '../site';

const mission = await getEntry('pages', 'mission');
const join = await getEntry('pages', 'join');
const themes = await getThemes();
const news = (await getNews()).slice(0, 3);
const pubs = await getPublications();
const featured = pubs.filter((p) => p.data.featured);
const papers = [...featured, ...pubs.filter((p) => !p.data.featured)].slice(0, 3);
const { current } = await getPeople();

const missionLine = mission?.data.description ?? themes[0]?.data.short ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.longName,
  alternateName: `${SITE.name}: ${SITE.tagline}`,
  url: SITE.url,
  logo: `${SITE.url}/apple-touch-icon.png`,
  email: SITE.email,
  description: missionLine,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: SITE.university,
    url: SITE.universityUrl,
    department: { '@type': 'Organization', name: SITE.department, url: SITE.departmentUrl },
  },
};
---
<Base description={missionLine || `${SITE.longName}: ${SITE.tagline} at UC Davis.`} jsonLd={jsonLd}>
  <!-- Hero: the one bold moment. Navy band, the gold brain drawing itself. -->
  <section class="hero relative isolate overflow-hidden bg-[var(--band)] text-white" aria-labelledby="hero-title">
    <div class="wrap relative grid items-center gap-8 pb-14 pt-12 sm:pb-20 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-6 lg:py-24">
      <div class="relative z-10">
        <p class="text-[0.95rem] text-white/75">{SITE.department} · UC Davis</p>
        <h1 id="hero-title" class="mt-4 font-display font-medium leading-[0.98] tracking-[-0.02em]">
          <span class="block text-[3.5rem] sm:text-[5rem] lg:text-[5.75rem]">{SITE.name}</span>
          <span class="mt-3 block text-[1.6rem] leading-[1.15] text-gold-400 sm:text-[2.1rem]">{SITE.tagline}</span>
        </h1>
        {missionLine && <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-white/85 sm:text-xl">{missionLine}</p>}
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-gold" href="/research/">Our research <Icon name="arrow" /></a>
          <a class="btn btn-ghost-light" href="/join/">Join the lab</a>
        </div>
      </div>
      <div class="hero-art pointer-events-none" aria-hidden="true">
        <BrainHero />
      </div>
    </div>
  </section>

  <!-- Research themes -->
  {
    themes.length > 0 && (
      <section class="wrap pt-16 sm:pt-24" aria-labelledby="themes-title">
        <SectionHead id="themes-title" title="Research" href="/research/" linkLabel="All research themes" />
        <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {themes.map((t, i) => (
            <li class="group relative">
              <ThemeIcon id={t.id} n={i + 1} class="size-14" />
              <h3 class="mt-4 font-display text-[1.4rem] leading-snug text-pretty">
                <a
                  href={`/research/#${t.id}`}
                  class="no-underline after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4"
                >
                  {t.data.title}
                </a>
              </h3>
              <p class="mt-2 text-[0.975rem] text-ink-2">{t.data.short}</p>
              {t.data.draft && <p class="mt-3"><span class="draft-tag">Draft</span></p>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- News beside papers -->
  <div class="wrap grid gap-16 pt-20 sm:pt-24 lg:grid-cols-2 lg:gap-20">
    {
      news.length > 0 && (
        <section aria-labelledby="news-title">
          <SectionHead id="news-title" title="News" href="/news/" linkLabel="All news" />
          <ul>
            {news.map((n) => (
              <li class="group relative grid grid-cols-[5.5rem_1fr] gap-4 border-b border-line py-5">
                <time class="pt-0.5 text-sm tabular-nums text-ink-2" datetime={isoDate(n.data.date)}>
                  {fmtMonth(n.data.date)}
                </time>
                <div>
                  <h3 class="font-sans text-[1.02rem] font-semibold leading-snug text-pretty">
                    <a href={`/news/${n.id}/`} class="no-underline after:absolute after:inset-0 group-hover:underline group-hover:underline-offset-4">
                      {n.data.title}
                    </a>
                  </h3>
                  <p class="mt-1 line-clamp-2 text-[0.95rem] text-ink-2">{n.data.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      papers.length > 0 && (
        <section aria-labelledby="papers-title">
          <SectionHead id="papers-title" title={featured.length ? 'Featured papers' : 'Recent papers'} href="/publications/" linkLabel="All publications" />
          <ul>
            {papers.map((p) => (
              <li class="group relative border-b border-line py-5">
                <h3 class="font-sans text-[1.02rem] font-semibold leading-snug text-pretty">
                  <a href={`/publications/#${p.id}`} class="no-underline after:absolute after:inset-0 group-hover:underline group-hover:underline-offset-4">
                    {p.data.title}
                  </a>
                </h3>
                <p class="mt-1 text-[0.95rem] text-ink-2">
                  <i>{p.data.venue}</i> · {p.data.year}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <!-- People -->
  {
    current.length > 0 && (
      <section class="wrap pt-20 sm:pt-24" aria-labelledby="people-title">
        <SectionHead id="people-title" title="People" href="/people/" linkLabel="Meet everyone" />
        <ul class="mt-10 grid grid-cols-[repeat(auto-fill,minmax(6.25rem,1fr))] gap-x-4 gap-y-7">
          {current.slice(0, 16).map((p) => (
            <li class="group relative text-center">
              <div class="mx-auto aspect-square w-full max-w-28 overflow-hidden rounded-full bg-paper-2 ring-1 ring-line">
                <PersonPhoto person={p} widths={[112, 224]} sizes="112px" decorative />
              </div>
              <p class="mt-2.5 text-sm font-medium leading-snug">
                <a class="no-underline after:absolute after:inset-0 group-hover:underline" href={`/people/${p.id}/`}>
                  {p.data.name}
                </a>
              </p>
              <p class="text-[0.8125rem] leading-snug text-ink-2">{p.data.role}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Join -->
  {
    join && (
      <section class="wrap pt-20 sm:pt-24" aria-labelledby="join-title">
        <div class="grid items-center gap-6 rounded-2xl border border-line-strong p-7 sm:p-10 md:grid-cols-[1fr_auto] md:gap-12">
          <div>
            <h2 id="join-title" class="section-title">Join the lab</h2>
            <p class="mt-3 max-w-[58ch] text-lg text-ink-2">{join.data.description}</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-solid" href="/join/">How to join <Icon name="arrow" /></a>
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    background-image: radial-gradient(60rem 36rem at 78% 50%, rgb(255 255 255 / 0.07), transparent 70%);
  }
  .hero-art {
    position: absolute;
    top: 1.5rem;
    right: -32%;
    width: 92%;
    opacity: 0.22;
  }
  @media (min-width: 40rem) {
    .hero-art {
      right: -18%;
      width: 70%;
    }
  }
  @media (min-width: 64rem) {
    .hero-art {
      position: relative;
      top: auto;
      right: auto;
      width: 100%;
      opacity: 1;
      margin-right: -1rem;
    }
  }
</style>
