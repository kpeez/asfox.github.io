---
import Base from '../layouts/Base.astro';
import BrainMark from '../components/BrainMark.astro';
---
<Base title="Page not found" description="This page does not exist on the Fox Lab website." noindex>
  <div class="wrap max-w-3xl py-20 sm:py-28">
    <span class="grid size-16 place-items-center rounded-2xl bg-navy-900 text-gold-400">
      <BrainMark class="w-11" strokeWidth={30} />
    </span>
    <h1 class="mt-8 font-display text-[2.75rem] leading-tight font-medium sm:text-[3.5rem]">Page not found</h1>
    <p class="mt-4 max-w-[52ch] text-lg text-ink-2">
      The page may have moved when the site was rebuilt. Try one of these:
    </p>
    <ul class="mt-6 grid gap-2 text-lg">
      <li><a class="link" href="/">Home</a></li>
      <li><a class="link" href="/publications/">Publications</a></li>
      <li><a class="link" href="/people/">People</a></li>
      <li><a class="link" href="/resources/">Tutorials and essays</a></li>
    </ul>
  </div>
</Base>
