---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonPhoto from '../../components/PersonPhoto.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getPeople, years } from '../../lib/data';

const { current, alumni } = await getPeople();
// The PI leads the page; everyone else follows in the grid (both in `order`).
const isPI = (role: string) => /principal investigator/i.test(role);
const leads = current.filter((p) => isPI(p.data.role));
const members = current.filter((p) => !isPI(p.data.role));
const firstParagraph = (body = '') =>
  body
    .split(/\n\s*\n/)
    .map((s) => s.trim())
    .find((s) => s && !s.startsWith('#') && !s.startsWith('!'))
    ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`]/g, '');
---
<Base title="People" description="Current members and alumni of the Fox Lab at UC Davis.">
  <PageHeader title="People" intro={`The ${current.length} people in the lab now, and the alumni who trained here.`} />

  <div class="wrap">
    <section aria-labelledby="current" class="pt-12 sm:pt-14">
      <h2 id="current" class="sr-only">Current members</h2>
      {
        leads.map((p) => (
          <div class="group relative mb-14 grid items-center gap-6 border-b border-line pb-12 sm:grid-cols-[13rem_1fr] sm:gap-10">
            <div class="aspect-square w-44 overflow-hidden rounded-full bg-paper-2 ring-1 ring-line sm:w-52">
              <PersonPhoto person={p} widths={[180, 270, 416]} sizes="208px" eager decorative />
            </div>
            <div>
              <p class="text-[0.95rem] text-ink-2">{p.data.role}</p>
              <h3 class="mt-1 font-display text-[2rem] leading-tight">
                <a href={`/people/${p.id}/`} class="no-underline after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                  {p.data.name}
                </a>
              </h3>
              {firstParagraph(p.body) && <p class="mt-3 max-w-[62ch] text-ink-2">{firstParagraph(p.body)}</p>}
            </div>
          </div>
        ))
      }
      <ul class="grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
        {
          members.map((p, i) => (
            <li class="group relative text-center">
              <div class="mx-auto aspect-square w-full max-w-52 overflow-hidden rounded-full bg-paper-2 ring-1 ring-line">
                <PersonPhoto
                  person={p}
                  widths={[180, 270, 416]}
                  sizes="(min-width: 640px) 208px, 42vw"
                  eager={i < 2}
                  decorative
                  class="transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </div>
              <h3 class="mt-4 font-display text-[1.35rem] leading-tight">
                <a href={`/people/${p.id}/`} class="no-underline after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                  {p.data.name}
                </a>
              </h3>
              <p class="mt-1 text-[0.95rem] text-ink-2">{p.data.role}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      alumni.length > 0 && (
        <section aria-labelledby="alumni" class="mt-24">
          <SectionHead id="alumni" title="Alumni" />
          <ul class="grid md:grid-cols-2 md:gap-x-10">
            {alumni.map((p) => (
              <li class="border-b border-line py-4">
                <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <a class="link font-medium !text-ink" href={`/people/${p.id}/`}>
                    {p.data.name}
                  </a>
                  <span class="text-sm tabular-nums text-ink-2">{years(p.data.start, p.data.end)}</span>
                </p>
                <p class="mt-0.5 text-[0.95rem] text-ink-2">
                  {p.data.role}
                  {p.data.now_at && <> · Now: {p.data.now_at}</>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
