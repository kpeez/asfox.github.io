---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonPhoto from '../../components/PersonPhoto.astro';
import { getPeople, years } from '../../lib/data';

const { current, alumni } = await getPeople();
---
<Base title="People" description="Current members and alumni of the Fox Lab at UC Davis.">
  <PageHeader title="People" intro={`The ${current.length} people in the lab now, and the alumni who trained here.`} />

  <div class="wrap">
    <section aria-labelledby="current" class="pt-12">
      <h2 id="current" class="sr-only">Current members</h2>
      <ul class="grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          current.map((p, i) => (
            <li class="group relative">
              <div class="aspect-[4/5] overflow-hidden rounded-lg bg-paper-2">
                <PersonPhoto
                  person={p}
                  widths={[240, 360, 480, 720]}
                  sizes="(min-width: 1152px) 264px, (min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw"
                  eager={i < 4}
                  class="transition-transform duration-300 group-hover:scale-[1.02]"
                />
              </div>
              <h3 class="mt-3 font-display text-[1.3rem] leading-tight">
                <a href={`/people/${p.id}/`} class="no-underline after:absolute after:inset-0 hover:underline hover:decoration-1 hover:underline-offset-4">
                  {p.data.name}
                </a>
              </h3>
              <p class="mt-1 text-[0.95rem] text-ink-2">{p.data.role}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      alumni.length > 0 && (
        <section aria-labelledby="alumni" class="mt-20">
          <h2 id="alumni" class="section-title">Alumni</h2>
          <span class="rule-gold mt-3" aria-hidden="true" />
          <ul class="mt-6 grid border-t border-line md:grid-cols-2 md:gap-x-10">
            {alumni.map((p) => (
              <li class="border-b border-line py-4">
                <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <a class="link font-medium !text-ink" href={`/people/${p.id}/`}>{p.data.name}</a>
                  <span class="text-sm tabular-nums text-ink-2">{years(p.data.start, p.data.end)}</span>
                </p>
                <p class="mt-0.5 text-[0.95rem] text-ink-2">
                  {p.data.role}
                  {p.data.now_at && <> · Now: {p.data.now_at}</>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
