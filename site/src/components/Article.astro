---
// Calm reading layout for news, tutorials, essays and free-standing pages.
interface Props {
  title: string;
  kicker?: { href: string; label: string };
  meta?: string;
  datetime?: string;
  lead?: string;
}
const { title, kicker, meta, datetime, lead } = Astro.props;
---
<article class="wrap max-w-[46rem] pt-10 sm:pt-14">
  <header>
    {
      kicker && (
        <p class="text-[0.95rem] text-ink-2">
          <a class="link !text-ink-2" href={kicker.href}>
            {kicker.label}
          </a>
        </p>
      )
    }
    <h1 class="mt-3 font-display text-[2.25rem] leading-[1.08] font-medium tracking-tight sm:text-[3rem]">{title}</h1>
    {meta && <p class="mt-4 text-[0.95rem] text-ink-2">{datetime ? <time datetime={datetime}>{meta}</time> : meta}</p>}
    {lead && <p class="mt-5 text-xl leading-relaxed text-ink-2">{lead}</p>}
    <span class="rule-gold mt-6" aria-hidden="true"></span>
  </header>
  <slot name="figure" />
  <div class="prose prose-fox mt-8">
    <slot />
  </div>
  <slot name="after" />
</article>
