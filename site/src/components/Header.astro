---
import BrainMark from './BrainMark.astro';
import { NAV, SITE } from '../site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-md supports-[backdrop-filter]:bg-paper/80">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3 rounded-md no-underline">
      <span class="grid size-9 place-items-center rounded-[10px] bg-navy-900 text-gold-400 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)]">
        <BrainMark class="w-7" strokeWidth={34} />
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.375rem] font-semibold tracking-tight">{SITE.name}</span>
        <span class="mt-1 hidden text-xs text-ink-2 sm:block">{SITE.tagline}</span>
      </span>
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong px-4 text-sm font-medium lg:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path class="i-open" d="M2 4.5h12M2 8h12M2 11.5h12"></path>
        <path class="i-close" d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path>
      </svg>
      Menu
    </button>

    <nav
      id="site-nav"
      aria-label="Main"
      class="max-lg:absolute max-lg:inset-x-0 max-lg:top-16 max-lg:hidden max-lg:border-b max-lg:border-line max-lg:bg-paper max-lg:shadow-lg max-lg:data-open:block"
    >
      <ul class="flex gap-1 max-lg:mx-auto max-lg:max-w-6xl max-lg:flex-col max-lg:px-4 max-lg:py-3 sm:max-lg:px-6 lg:items-center">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-link flex min-h-11 items-center rounded-md px-3 text-[0.95rem] text-ink-2 no-underline transition-colors hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink max-lg:min-h-12 max-lg:text-[1.0625rem] max-lg:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
<noscript><style>#site-nav{display:block!important;position:static!important;box-shadow:none!important}#nav-toggle{display:none!important}</style></noscript>

<script>
  const btn = document.getElementById('nav-toggle')!;
  const nav = document.getElementById('site-nav')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      set(false);
      btn.focus();
    }
  });
</script>

<style>
  .site-header {
    view-transition-name: site-header;
  }
  .i-close,
  #nav-toggle[aria-expanded='true'] .i-open {
    display: none;
  }
  #nav-toggle[aria-expanded='true'] .i-close {
    display: inline;
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    text-decoration-color: var(--accent);
  }
  @media (max-width: 63.999rem) {
    .nav-link[aria-current='page'] {
      text-decoration: none;
      box-shadow: inset 3px 0 0 var(--accent);
      border-radius: 0;
    }
  }
</style>
