---
// Line icons for the research themes, keyed by theme id. A theme without an icon shows its number.
// Navy strokes with one small gold accent; decorative (the theme title is the label).
interface Props {
  id: string;
  n: number;
  class?: string;
}
const { id, n, class: cls = '' } = Astro.props;
type Icon = { base: string; accent: string };
const icons: Record<string, Icon> = {
  // A young primate's face.
  'anxious-temperament': {
    base: 'M24 9.5c-6.6 0-11 4.6-11 10.6 0 3.2 1.2 5.6 3 7.3.6 4.6 3.9 7.6 8 7.6s7.4-3 8-7.6c1.8-1.7 3-4.1 3-7.3 0-6-4.4-10.6-11-10.6zM13.4 17.2a4 4 0 10-1.6 7.4M34.6 17.2a4 4 0 111.6 7.4M19.5 28.2c1.3 1.1 2.8 1.7 4.5 1.7s3.2-.6 4.5-1.7',
    accent: 'M19.5 21h.01M28.5 21h.01',
  },
  // Waiting on a clock for a threat that may or may not come.
  'uncertain-threat': {
    base: 'M17 9.5a9.5 9.5 0 100 19 9.5 9.5 0 000-19zM17 13.5v5.5l3.5 2.3M5 37.5h14M23 37.5h3M30 37.5h3',
    accent: 'M37 21.5l6 10.5H31zM37 25.6v2.6M37 30.1h.01',
  },
  // A viral capsid carrying cargo to one cell type.
  'viral-tools': {
    base: 'M15 7l8.2 4.75v9.5L15 26l-8.2-4.75v-9.5zM15 11.5l4.3 7.4h-8.6zM15 7v4.5M23.2 11.75l-3.9 7.15M6.8 11.75l3.9 7.15M15 26l-4.3-7.1M15 26l4.3-7.1M36 27.5a5 5 0 100 10 5 5 0 000-10zM36 27.5v-5M31.8 35.3l-4.3 3.7M40.2 35.3l4.3 3.7',
    accent: 'M25.5 22.5l5 3.5M30.5 26l-.4-3.2M30.5 26l-3.1.6',
  },
  // A gut-to-brain pathway.
  'gut-brain-parkinsons': {
    base: 'M7.5 14.5c0-4.4 3.5-8 8.5-8 4.7 0 8.5 3 8.5 7.2 0 3.3-2.3 5.6-5.2 6-.7 1.9-2.3 3-4.3 3-2.3 0-4-1.4-4.4-3.3-1.9-1-3.1-2.8-3.1-4.9zM12 13.5c1.7-1.3 3.7-1.2 5 .2M16.5 6.8c-.6 2.2.3 4 2.4 4.8M15 22.7V30c0 2 1.6 3.5 3.5 3.5H32a3.5 3.5 0 010 7h-5a2.75 2.75 0 000 5.5h9',
    accent: 'M20.5 33.5h3',
  },
};
const icon = icons[id];
---
{
  icon ? (
    <svg class:list={['theme-icon', cls]} viewBox="0 0 48 48" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d={icon.base} stroke="var(--accent)" />
      <path d={icon.accent} stroke="var(--color-gold-400)" stroke-width="2.4" />
    </svg>
  ) : (
    <span class:list={['font-display text-[1.6rem] leading-none text-ink-2 tabular-nums', cls]} aria-hidden="true">
      {String(n).padStart(2, '0')}
    </span>
  )
}
